# Copy to .env for local runs, or set these on Railway.

# Railway provides this when you add a Postgres database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pipeline

# Long random string. Signs the sign-in sessions. Changing it signs everyone out.
SECRET_KEY=change-me

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
GOOGLE_CLIENT_ID=

# Only accounts on this domain can sign in.
ALLOWED_DOMAIN=hstile.com

# Comma-separated. These become admins on their first sign-in.
ADMIN_EMAILS=

# Testing only: sign in by typing an email, no Google. Never on in production.
DEV_LOGIN=0

APP_TIMEZONE=America/New_York

# NetSuite, read-only item sync. Token-based auth: the integration's consumer
# key/secret plus this app's own access token. All five, or the sync stays off.
NS_ACCOUNT_ID=5032967
NS_CONSUMER_KEY=
NS_CONSUMER_SECRET=
NS_TOKEN_ID=
NS_TOKEN_SECRET=
# Minutes between refreshes. 0 = only when someone presses Sync now.
NS_SYNC_MINUTES=60
